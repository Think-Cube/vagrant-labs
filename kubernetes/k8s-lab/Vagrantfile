# -*- mode: ruby -*-
# vi: set ft=ruby :

CONTROL_IP = "192.168.56.50"
WORKERS = [
  { name: "worker1", ip: "192.168.56.51" },
  { name: "worker2", ip: "192.168.56.52" },
]
K8S_VERSION = "1.30"

COMMON = <<-SHELL
  apt-get update -qq
  apt-get install -y apt-transport-https ca-certificates curl gpg
  # Disable swap
  swapoff -a
  sed -i '/swap/d' /etc/fstab
  # Load kernel modules
  modprobe overlay && modprobe br_netfilter
  cat > /etc/sysctl.d/k8s.conf <<EOF
net.bridge.bridge-nf-call-iptables  = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward                 = 1
EOF
  sysctl --system
  # Install containerd
  apt-get install -y containerd
  mkdir -p /etc/containerd
  containerd config default > /etc/containerd/config.toml
  sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
  systemctl restart containerd && systemctl enable containerd
  # Install kubeadm, kubelet, kubectl
  curl -fsSL https://pkgs.k8s.io/core:/stable:/v#{K8S_VERSION}/deb/Release.key | gpg --dearmor -o /etc/apt/keyrings/kubernetes.gpg
  echo "deb [signed-by=/etc/apt/keyrings/kubernetes.gpg] https://pkgs.k8s.io/core:/stable:/v#{K8S_VERSION}/deb/ /" > /etc/apt/sources.list.d/kubernetes.list
  apt-get update -qq
  apt-get install -y kubelet kubeadm kubectl
  apt-mark hold kubelet kubeadm kubectl
SHELL

Vagrant.configure("2") do |config|
  config.vm.box              = "bento/ubuntu-24.04"
  config.vm.box_check_update = false

  config.vm.define "control" do |vm|
    vm.vm.hostname = "k8s-control"
    vm.vm.network "private_network", ip: CONTROL_IP

    vm.vm.provider "virtualbox" do |vb|
      vb.name   = "k8s-control"
      vb.memory = 2048
      vb.cpus   = 2
      vb.gui    = false
    end

    vm.vm.provider "vmware_desktop" do |vmware|
      vmware.vmx["displayName"] = "k8s-control"
      vmware.vmx["memsize"]     = "2048"
      vmware.vmx["numvcpus"]    = "2"
      vmware.gui                = false
    end

    vm.vm.provision "shell", inline: COMMON
    vm.vm.provision "shell", inline: <<-SHELL
      kubeadm init --apiserver-advertise-address=#{CONTROL_IP} \
                   --pod-network-cidr=10.244.0.0/16 \
                   --node-name=k8s-control
      mkdir -p /home/vagrant/.kube
      cp /etc/kubernetes/admin.conf /home/vagrant/.kube/config
      chown -R vagrant:vagrant /home/vagrant/.kube
      # Flannel CNI
      kubectl --kubeconfig=/etc/kubernetes/admin.conf apply -f https://raw.githubusercontent.com/flannel-io/flannel/master/Documentation/kube-flannel.yml
      # Save join command
      kubeadm token create --print-join-command > /vagrant/join_command.sh
      echo "Control plane ready at #{CONTROL_IP}"
    SHELL
  end

  WORKERS.each do |worker|
    config.vm.define worker[:name] do |vm|
      vm.vm.hostname = "k8s-#{worker[:name]}"
      vm.vm.network "private_network", ip: worker[:ip]

      vm.vm.provider "virtualbox" do |vb|
        vb.name   = "k8s-#{worker[:name]}"
        vb.memory = 2048
        vb.cpus   = 2
        vb.gui    = false
      end

      vm.vm.provider "vmware_desktop" do |vmware|
        vmware.vmx["displayName"] = "k8s-#{worker[:name]}"
        vmware.vmx["memsize"]     = "2048"
        vmware.vmx["numvcpus"]    = "2"
        vmware.gui                = false
      end

      vm.vm.provision "shell", inline: COMMON
      vm.vm.provision "shell", inline: <<-SHELL
        until [ -f /vagrant/join_command.sh ]; do sleep 3; done
        bash /vagrant/join_command.sh
        echo "#{worker[:name]} joined the cluster"
      SHELL
    end
  end
end
