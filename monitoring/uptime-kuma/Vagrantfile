# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box              = "bento/ubuntu-24.04"
  config.vm.box_check_update = false
  config.vm.hostname         = "uptime-kuma"

  config.vm.network "private_network", ip: "192.168.56.74"
  config.vm.network "forwarded_port",  guest: 3001, host: 3003

  config.vm.provider "virtualbox" do |vb|
    vb.name   = "uptime-kuma"
    vb.memory = 1024
    vb.cpus   = 1
    vb.gui    = false
  end

  config.vm.provider "vmware_desktop" do |vmware|
    vmware.vmx["displayName"] = "uptime-kuma"
    vmware.vmx["memsize"]     = "1024"
    vmware.vmx["numvcpus"]    = "1"
    vmware.gui                = false
  end

  config.vm.provision "shell", inline: <<-SHELL
    apt-get update -qq
    apt-get install -y docker.io
    systemctl enable docker && systemctl start docker

    docker run -d \
      --name uptime-kuma \
      --restart unless-stopped \
      -p 3001:3001 \
      -v uptime-kuma:/app/data \
      louislam/uptime-kuma:1

    echo "Uptime Kuma ready."
    echo "UI: http://192.168.56.74:3001"
    echo "Create your admin account on first visit."
  SHELL
end
